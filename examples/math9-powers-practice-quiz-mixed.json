        },
        {
          "prompt": "Diameter of a red blood cell: $0.0000075$ m",
          "answer": "$7.5\\times10^{-6}$ m",
          "solution": "The decimal point moves 6 places right, so the exponent is $-6$"
        },
        {
          "prompt": "$45\\times10^4 =$",
          "answer": "$4.5\\times10^5$",
          "solution": "$= 4.5\\times10^1\\times10^4$\n$= 4.5\\times10^{1+4}$"
        }
      ]
    },
    {
      "kind": "question",
      "prompt": "Calculate. Write each answer in scientific notation.",
      "columns": 3,
      "space": 2,
      "parts": [
        {
          "prompt": "$(3\\times10^4)(2\\times10^5) =$",
          "answer": "$6\\times10^9$",
          "solution": "$= (3\\times2)\\times(10^4\\times10^5)$\n$= 6\\times10^{4+5}$"
        },
        {
          "prompt": "$\\dfrac{8\\times10^{-3}}{2\\times10^5} =$",
          "answer": "$4\\times10^{-8}$",
          "solution": "$= \\dfrac{8}{2}\\times\\dfrac{10^{-3}}{10^5}$\n$= 4\\times10^{-3-5}$"
        },
        {
          "prompt": "$(5\\times10^3)(4\\times10^6) =$",
          "answer": "$2\\times10^{10}$",
          "solution": "$= (5\\times4)\\times10^{3+6}$\n$= 20\\times10^9$\n$= 2\\times10^1\\times10^9$"
        }
      ]
    },
    {
      "kind": "question",
      "prompt": "Light travels about $3\\times10^5$ km every second. Sunlight takes about $5\\times10^2$ seconds to reach Earth. About how far away is the Sun? Write your answer in scientific notation.",
      "space": 3,
      "marks": 1,
      "answer": "$1.5\\times10^8$ km",
      "solution": "distance = speed × time\n$= (3\\times10^5)(5\\times10^2)$\n$= 15\\times10^7$\n$= 1.5\\times10^1\\times10^7$"
    }
  ]
