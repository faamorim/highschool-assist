        "seed": "practice-mixed-2026-11/1c",
        "count": 4
      },
      "parts": [
        {
          "prompt": "$6^{-2} =$",
          "answer": "$\\frac{1}{36}$",
          "solution": "$= \\dfrac{1}{6^2}$"
        },
        {
          "prompt": "$\\left(\\dfrac{1}{3}\\right)^{-3} =$",
          "answer": "$27$",
          "solution": "$= 3^3$"
        },
        {
          "prompt": "$\\dfrac{5}{4^{-2}} =$",
          "answer": "$80$",
          "solution": "$= 5\\times4^2$\n$= 5\\times16$"
        },
        {
          "prompt": "$(0.5)^{-3} =$",
          "answer": "$8$",
          "solution": "$= \\left(\\dfrac{1}{2}\\right)^{-3}$\n$= 2^3$"
        }
      ]
    },
    {
      "kind": "question",
      "prompt": "Which is greater? Show how you know.",
      "columns": 2,
      "space": 2,
      "marks": 1,
      "parts": [
        {
          "prompt": "$2^{-3}$ or $3^{-2}$",
          "answer": "$2^{-3}$",
          "solution": "$2^{-3} = \\dfrac{1}{2^3} = \\dfrac{1}{8}$ and $3^{-2} = \\dfrac{1}{3^2} = \\dfrac{1}{9}$\n$\\dfrac{1}{8} > \\dfrac{1}{9}$ (same numerator, smaller denominator)"
        },
        {
          "prompt": "$\\left(\\dfrac{1}{2}\\right)^{-2}$ or $2^{-2}$",
          "answer": "$\\left(\\frac{1}{2}\\right)^{-2}$",
          "solution": "$\\left(\\dfrac{1}{2}\\right)^{-2} = 2^2 = 4$ and $2^{-2} = \\dfrac{1}{2^2} = \\dfrac{1}{4}$\n$4 > \\dfrac{1}{4}$"
        }
      ]
    },
    {
      "kind": "heading",
      "text": "Exponent laws"
    },
    {
      "kind": "question",
      "prompt": "Simplify. Write each answer as a single power.",
      "columns": 2,
      "space": 1.5,
      "parts": [
        {
          "prompt": "$7^{-9}\\times 7^7 =$",
          "answer": "$7^{-2}$",
          "solution": "$= 7^{-9+7}$"
        },
        {
          "prompt": "$b^{-12}\\div b^9 =$",
          "answer": "$b^{-21}$",
          "solution": "$= b^{-12-9}$"
        },
        {
          "prompt": "$(z^{-2})^{-2}\\times (z^{-3})^4 =$",
          "answer": "$z^{-8}$",
          "solution": "$= z^{-2\\times(-2)}\\times z^{-3\\times4}$\n$= z^4\\times z^{-12}$\n$= z^{4+(-12)}$"
        },
        {
          "prompt": "$(6^4)^{-2}\\div (6^{-3})^{-3} =$",
          "answer": "$6^{-17}$",
          "solution": "$= 6^{4\\times(-2)}\\div 6^{-3\\times(-3)}$\n$= 6^{-8}\\div 6^9$\n$= 6^{-8-9}$"
        }
      ]
    },
    {
      "kind": "question",
      "prompt": "Each answer has a mistake. Find it, explain it, and write the correct answer.",
      "columns": 1,
      "space": 2,
      "marks": 1,
      "parts": [
        {
          "prompt": "$3^4\\times3^2 = 9^6$",
          "answer": "$3^6$",
          "solution": "Same base: keep the base and add the exponents. The base does not get multiplied.\n$3^4\\times3^2 = 3^{4+2}$"
        },
        {
          "prompt": "$\\dfrac{x^{-2}}{x^5} = x^3$",
          "answer": "$x^{-7}$",
          "solution": "Dividing: subtract the exponents, top minus bottom.\n$= x^{-2-5}$"
        },
        {
          "prompt": "$4^{-2} = -16$",
          "answer": "$\\frac{1}{16}$",
          "solution": "A negative exponent means reciprocal, not a negative number.\n$= \\dfrac{1}{4^2}$"
        }
      ]
    },
    {
      "kind": "question",
      "prompt": "Simplify",
      "columns": 1,
      "space": 1.5,
      "parts": [
        {
          "prompt": "$42a^2\\div 7a^{-7} =$",
          "answer": "$6a^9$",
          "solution": "$= \\frac{42}{7}\\,a^{2-(-7)}$"
        },
        {
          "prompt": "$7c^{-2}\\times (-9c^6) =$",
          "answer": "$-63c^4$",
          "solution": "$= (7)(-9)\\,c^{-2+6}$"
        },
        {
          "prompt": "$5p^4\\times (-6p^5)\\div 5p^{-4} =$",
          "answer": "$-6p^{13}$",
          "solution": "$= (5)(-6)\\,p^{4+5}\\div 5p^{-4}$\n$= -30p^9\\div 5p^{-4}$\n$= \\frac{-30}{5}\\,p^{9-(-4)}$"
        }
      ]
    },
    {
      "kind": "question",
      "prompt": "Solve",
      "columns": 3,
      "space": 3,
      "generator": {
        "name": "powers.solve-exponential",
        "params": {
          "forms": [
            "unknown-exponent",
            "power-of-ten",
            "reciprocal-base"
          ]
        },
        "seed": "practice-mixed-2026-11/2",
        "count": 3
      },
      "parts": [
        {
          "prompt": "$5^x = \\dfrac{1}{5}$",
          "answer": "$x=-1$",
          "solution": "$5^x = 5^{-1}$\nSame base, so the exponents are equal"
        },
        {
          "prompt": "$10^{4-x} = 0.01$",
          "answer": "$x=6$",
          "solution": "$10^{4-x} = \\dfrac{1}{100} = \\dfrac{1}{10^2}$\n$10^{4-x} = 10^{-2}$\n$4 - x = -2$\n$-x = -6$"
        },
        {
          "prompt": "$9 = \\left(\\dfrac{1}{3}\\right)^{x+2}$",
          "answer": "$x=-4$",
          "solution": "$3^2 = \\left(3^{-1}\\right)^{x+2}$\n$3^2 = 3^{-x-2}$\n$2 = -x - 2$\n$4 = -x$"
        }
      ]
    },
    {
      "kind": "heading",
      "text": "Scientific notation"
    },
    {
      "kind": "question",
      "prompt": "Write in scientific notation",
      "columns": 1,
      "space": 1,
      "parts": [
        {
          "prompt": "Distance from Earth to the Moon: $384\\,000$ km",
          "answer": "$3.84\\times10^5$ km",
